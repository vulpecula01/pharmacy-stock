{{-- Lot Modal --}}
<div id="lot-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center animate-in fade-in duration-200">
    <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full mx-4 overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                <i class="fas fa-history text-blue-500"></i> ประวัติ Lot และวันหมดอายุเดิม
            </h3>
            <button type="button" onclick="closeLotModal()" class="text-gray-400 hover:text-gray-600">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>
        <div class="p-6">
            <div class="overflow-y-auto max-h-60 rounded-xl border border-gray-100">
                <table class="w-full text-left text-sm">
                    <thead class="bg-gray-50 text-gray-600 font-bold">
                        <tr>
                            <th class="p-3">ชื่อล็อต (Lot)</th>
                            <th class="p-3">วันหมดอายุ</th>
                            <th class="p-3 text-right">จำนวนคงเหลือ</th>
                        </tr>
                    </thead>
                    <tbody id="lot-history-table"></tbody>
                </table>
            </div>
        </div>
        <div class="p-4 bg-gray-50 text-right">
            <button type="button" onclick="closeLotModal()" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-xl font-bold hover:bg-gray-300 transition-all">ปิด</button>
        </div>
    </div>
</div>

<script>
    let currentLotData = [];
    const barcodeInput = document.getElementById('barcode_input');
    const nameInput = document.getElementById('name_input');
    const unitSelect = document.getElementById('unit_select');
    const categorySelect = document.getElementById('category_select');
    const companyInput = document.getElementById('company_input');
    const expireInput = document.getElementById('expire_input');
    const priceInput = document.getElementById('price_input'); 
    const minInput = document.getElementById('min_input');
    const maxInput = document.getElementById('max_input');
    const spinner = document.getElementById('loading-spinner');
    const statusMsg = document.getElementById('status-msg');
    const stockPanel = document.getElementById('stock-info-panel');
    const masterDisplay = document.getElementById('display_master');
    const btnViewLots = document.getElementById('btn-view-lots');
    const lotModal = document.getElementById('lot-modal');
    const lotTableBody = document.getElementById('lot-history-table');
    const receiveDateInput = document.getElementById('receive_date_input');
    const lotNumberHidden = document.getElementById('lot_number_hidden');
    const receiveForm = document.getElementById('receive-form');
    const submitBtn = document.getElementById('submit-btn');

    function setDefaultReceiveDate() {
        if (receiveDateInput && !receiveDateInput.value) {
            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');
            receiveDateInput.value = `${yyyy}-${mm}-${dd}`;
        }
    }

    window.addEventListener('DOMContentLoaded', () => {
        setDefaultReceiveDate();
    });

    // 🟢 ก่อนจะ Submit ฟอร์ม ตรวจสอบว่าปุ่มส่งจะทำงานได้ปกติ ไม่ล็อกค้างกรณี Validation ผิดพลาดจากเบราวเซอร์
    if(receiveForm) {
        receiveForm.addEventListener('submit', function(e) {
            // เช็คความชัวร์ว่าเลือกหมวดหมู่หรือยัง ถ้าไม่มีค่าให้เตือน
            if(!categorySelect.value) {
                e.preventDefault();
                Swal.fire('แจ้งเตือน', 'กรุณาเลือกหมวดหมู่ยาก่อนบันทึก', 'warning');
                return false;
            }
            
            if(submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerText = 'กำลังบันทึกข้อมูล...';
                submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
            }
        });
    }

    barcodeInput.addEventListener('change', function() {
        let rawBarcode = this.value.trim();
        let cleanBarcode = rawBarcode.replace(/[^\w-]/g, ''); 
        this.value = cleanBarcode;

        if (!cleanBarcode) return;

        spinner.classList.remove('hidden');
        statusMsg.innerText = 'กำลังตรวจสอบข้อมูล...';
        statusMsg.className = 'text-xs mt-1 block text-gray-500';

        fetch("{{ url('/api/check-medicine') }}/" + encodeURIComponent(cleanBarcode))
            .then(response => response.json())
            .then(data => {
                spinner.classList.add('hidden');
                if (data.exists) {
                    nameInput.value = data.name || '';
                    companyInput.value = data.company_name || '';
                    unitSelect.value = data.unit_name || '';
                    
                    // 🟢 แมตช์ค่าหมวดหมู่ให้ตรงกับ Select Option
                    if(data.category) {
                        categorySelect.value = data.category;
                    }
                    
                    minInput.value = data.min_stock || '';
                    maxInput.value = data.max_stock || '';
                    priceInput.value = data.price_per_unit || ''; 
                    
                    btnViewLots.classList.remove('hidden');
                    currentLotData = data.lots || []; 

                    stockPanel.classList.remove('hidden');
                    masterDisplay.innerText = Number(data.stock_master || 0).toLocaleString();
                    
                    statusMsg.innerText = 'พบข้อมูลยาเดิม: ' + data.name;
                    statusMsg.className = 'text-xs mt-1 block text-green-600 font-bold';
                    
                    priceInput.focus(); 
                } else {
                    btnViewLots.classList.add('hidden');
                    currentLotData = [];
                    lotNumberHidden.value = '';
                    stockPanel.classList.add('hidden');
                    nameInput.value = '';
                    unitSelect.value = ''; 
                    categorySelect.value = '';
                    companyInput.value = '';
                    expireInput.value = '';
                    priceInput.value = ''; 
                    minInput.value = '';
                    maxInput.value = '';
                    statusMsg.innerText = 'ไม่พบข้อมูล (ยาใหม่)';
                    statusMsg.className = 'text-xs mt-1 block text-orange-500 font-bold';
                    nameInput.focus();
                }
            })
            .catch(error => {
                spinner.classList.add('hidden');
                statusMsg.innerText = 'ข้อผิดพลาดในการเชื่อมต่อ API';
                statusMsg.className = 'text-xs mt-1 block text-red-500 font-bold';
            });
    });

    btnViewLots.addEventListener('click', function() {
        lotTableBody.innerHTML = '';
        if (!currentLotData || currentLotData.length === 0) {
            lotTableBody.innerHTML = '<tr><td colspan="3" class="p-4 text-center text-gray-500">ไม่พบประวัติ Lot</td></tr>';
        } else {
            currentLotData.forEach(lot => {
                const row = `<tr class="border-t border-gray-100 hover:bg-blue-50 cursor-pointer" onclick="fillLotInfo('${lot.lot_number || ''}', '${lot.expire_date || ''}')">
                    <td class="p-3 font-mono text-gray-600">${lot.lot_number || '-'}</td>
                    <td class="p-3 font-medium">${lot.expire_date || '-'}</td>
                    <td class="p-3 text-right font-bold text-blue-600">${Number(lot.quantity || 0).toLocaleString()}</td>
                </tr>`;
                lotTableBody.innerHTML += row;
            });
        }
        lotModal.classList.remove('hidden');
    });

    function fillLotInfo(lotNumber, expireDate) {
        if(expireInput) expireInput.value = expireDate;
        if(lotNumberHidden) lotNumberHidden.value = lotNumber;
        closeLotModal();
        statusMsg.innerText = 'เลือกล็อตเดิมสำเร็จ: ' + lotNumber;
        statusMsg.className = 'text-xs mt-1 block text-blue-600 font-bold';
    }

    function closeLotModal() {
        lotModal.classList.add('hidden');
    }

    barcodeInput.addEventListener('keypress', (e) => { 
        if(e.key === 'Enter') { 
            e.preventDefault(); 
            barcodeInput.blur(); 
        } 
    });
</script>

@if(session('success'))
<script>
    Swal.fire({
        title: 'บันทึกสำเร็จ!',
        text: "{!! session('success') !!}",
        icon: 'success',
        timer: 2000,
        showConfirmButton: false,
        customClass: {
            popup: 'rounded-[2.5rem]',
        }
    });

    // ล้างค่าฟอร์มด้วยวิธีที่ปลอดภัย
    document.getElementById('receive-form').reset();
    document.getElementById('lot_number_hidden').value = '';
    document.getElementById('display_master').innerText = '0';
    document.getElementById('stock-info-panel').classList.add('hidden');
    document.getElementById('btn-view-lots').classList.add('hidden');
    document.getElementById('status-msg').innerText = '';
    
    setTimeout(() => {
        setDefaultReceiveDate();
        document.getElementById('barcode_input').focus();
    }, 100);
</script>
@endif
@endsection